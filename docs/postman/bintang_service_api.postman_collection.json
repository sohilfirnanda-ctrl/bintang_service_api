{
 "info": {
  "name": "Bintang Service API",
  "description": "Backend API pemesanan servis motor Bintang Service (Laravel + Sanctum).\n\nCara pakai: import collection & environment, pilih environment 'Bintang Service - Local', jalankan `php artisan migrate:fresh --seed`, lalu Run collection dari atas ke bawah.\nAkun seeder: admin@bintangservice.test / rahmat@example.com (password: password123).",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "item": [
  {
   "name": "1. Auth",
   "item": [
    {
     "name": "Register Pelanggan Baru",
     "request": {
      "method": "POST",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "url": "{{base_url}}/register",
      "body": {"mode": "raw", "raw": "{\"name\": \"Pelanggan Uji\", \"email\": \"pelanggan{{$timestamp}}@example.com\", \"phone\": \"081234567890\", \"password\": \"password123\", \"password_confirmation\": \"password123\"}", "options": {"raw": {"language": "json"}}},
      "auth": {"type": "noauth"}
     },
     "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
      "pm.test(\"[T01] Register 201\", () => pm.response.to.have.status(201));",
      "pm.test(\"Format {status, message, data}\", () => { const j = pm.response.json(); pm.expect(j).to.include.keys(\"status\",\"message\",\"data\"); });",
      "pm.test(\"Tidak ada password/remember_token\", () => { const t = pm.response.text(); pm.expect(t).to.not.include(\"\\\"password\\\"\"); pm.expect(t).to.not.include(\"remember_token\"); });",
      "pm.test(\"Response berisi token\", () => pm.expect(pm.response.json().data.token).to.be.a(\"string\").and.not.empty);"
     ]}}]
    },
    {
     "name": "Login Pelanggan",
     "request": {
      "method": "POST",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "url": "{{base_url}}/login",
      "body": {"mode": "raw", "raw": "{\"email\": \"rahmat@example.com\", \"password\": \"password123\"}", "options": {"raw": {"language": "json"}}},
      "auth": {"type": "noauth"}
     },
     "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
      "pm.test(\"[T02] Login 200\", () => pm.response.to.have.status(200));",
      "pm.test(\"Format {status, message, data}\", () => { const j = pm.response.json(); pm.expect(j).to.include.keys(\"status\",\"message\",\"data\"); });",
      "pm.test(\"Tidak ada password/remember_token\", () => { const t = pm.response.text(); pm.expect(t).to.not.include(\"\\\"password\\\"\"); pm.expect(t).to.not.include(\"remember_token\"); });",
      "const tk = pm.response.json().data.token;",
      "pm.test(\"Response berisi token\", () => pm.expect(tk).to.be.a(\"string\").and.not.empty);",
      "pm.environment.set(\"token\", tk);"
     ]}}]
    },
    {
     "name": "Login Admin",
     "request": {
      "method": "POST",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "url": "{{base_url}}/login",
      "body": {"mode": "raw", "raw": "{\"email\": \"admin@bintangservice.test\", \"password\": \"password123\"}", "options": {"raw": {"language": "json"}}},
      "auth": {"type": "noauth"}
     },
     "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
      "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
      "pm.environment.set(\"admin_token\", pm.response.json().data.token);"
     ]}}]
    },
    {
     "name": "Login Password Salah",
     "request": {
      "method": "POST",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "url": "{{base_url}}/login",
      "body": {"mode": "raw", "raw": "{\"email\": \"rahmat@example.com\", \"password\": \"salah123\"}", "options": {"raw": {"language": "json"}}},
      "auth": {"type": "noauth"}
     },
     "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
      "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
      "pm.test(\"Format {status, message, data}\", () => { const j = pm.response.json(); pm.expect(j).to.include.keys(\"status\",\"message\",\"data\"); });"
     ]}}]
    },
    {
     "name": "Profil Saya (me)",
     "request": {
      "method": "GET",
      "url": "{{base_url}}/me",
      "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}
     },
     "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
      "pm.test(\"[T03] Protected endpoint dengan token 200\", () => pm.response.to.have.status(200));",
      "pm.test(\"Format {status, message, data}\", () => { const j = pm.response.json(); pm.expect(j).to.include.keys(\"status\",\"message\",\"data\"); });",
      "pm.test(\"Tidak ada password/remember_token\", () => { const t = pm.response.text(); pm.expect(t).to.not.include(\"\\\"password\\\"\"); pm.expect(t).to.not.include(\"remember_token\"); });"
     ]}}]
    },
    {
     "name": "Ubah Profil",
     "request": {
      "method": "PUT",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "url": "{{base_url}}/profile",
