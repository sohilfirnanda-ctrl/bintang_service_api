     ]}}]
    },
    {
     "name": "Ubah Jadwal Booking",
     "request": {
      "method": "PUT",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "url": "{{base_url}}/bookings/{{booking_id}}",
      "body": {"mode": "raw", "raw": "{\"booking_time\": \"14:00\"}", "options": {"raw": {"language": "json"}}}
     },
     "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
      "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
      "pm.test(\"Format {status, message, data}\", () => { const j = pm.response.json(); pm.expect(j).to.include.keys(\"status\",\"message\",\"data\"); });"
     ]}}]
    },
    {
     "name": "Batalkan Booking",
     "request": {"method": "PATCH", "url": "{{base_url}}/bookings/{{booking_id}}/cancel"},
     "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
      "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
      "pm.test(\"Status cancelled\", () => pm.expect(pm.response.json().data.status).to.eql(\"cancelled\"));"
     ]}}]
    },
    {
     "name": "Riwayat Booking Tanpa Token (401)",
     "request": {"method": "GET", "url": "{{base_url}}/bookings", "auth": {"type": "noauth"}},
     "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
      "pm.test(\"[T06] Request protected tanpa token 401\", () => pm.response.to.have.status(401));",
      "pm.test(\"Format {status, message, data}\", () => { const j = pm.response.json(); pm.expect(j).to.include.keys(\"status\",\"message\",\"data\"); });"
     ]}}]
    }
   ]
