  {
   "name": "3. Bookings (pelanggan)",
   "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
   "item": [
    {
     "name": "Buat Booking Valid",
     "request": {
      "method": "POST",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "url": "{{base_url}}/bookings",
      "body": {"mode": "raw", "raw": "{\"motor_type\": \"Honda Beat 2021\", \"plate_number\": \"BL 1234 AB\", \"booking_date\": \"{{booking_date}}\", \"booking_time\": \"09:30\", \"complaint\": \"Mesin kasar saat dingin.\", \"service_ids\": [1, 2]}", "options": {"raw": {"language": "json"}}}
     },
     "event": [
      {"listen": "prerequest", "script": {"type": "text/javascript", "exec": [
       "const d = new Date(); d.setDate(d.getDate() + 3);",
       "pm.environment.set(\"booking_date\", d.toISOString().slice(0, 10));"
      ]}},
      {"listen": "test", "script": {"type": "text/javascript", "exec": [
       "pm.test(\"[T04] POST data valid 201\", () => pm.response.to.have.status(201));",
       "pm.test(\"Format {status, message, data}\", () => { const j = pm.response.json(); pm.expect(j).to.include.keys(\"status\",\"message\",\"data\"); });",
       "const b = pm.response.json().data;",
       "pm.test(\"Total harga = jumlah harga layanan\", () => pm.expect(b.total_price).to.eql(b.details.reduce((s, d) => s + d.price, 0)));",
       "pm.environment.set(\"booking_id\", b.id);"
      ]}}
     ]
    },
    {
     "name": "Buat Booking Tidak Valid (422)",
     "request": {
      "method": "POST",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "url": "{{base_url}}/bookings",
      "body": {"mode": "raw", "raw": "{\"motor_type\": \"\", \"plate_number\": \"BL 1234 AB\", \"booking_date\": \"2020-01-01\", \"booking_time\": \"25:99\", \"service_ids\": []}", "options": {"raw": {"language": "json"}}}
     },
     "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
      "pm.test(\"[T05] Data invalid 422\", () => pm.response.to.have.status(422));",
      "pm.test(\"Ada detail errors per field\", () => pm.expect(pm.response.json().errors).to.include.keys(\"motor_type\",\"booking_date\",\"booking_time\",\"service_ids\"));"
     ]}}]
    },
    {
     "name": "Riwayat Booking Saya",
     "request": {"method": "GET", "url": "{{base_url}}/bookings?per_page=5"},
     "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
      "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
      "pm.test(\"Format {status, message, data}\", () => { const j = pm.response.json(); pm.expect(j).to.include.keys(\"status\",\"message\",\"data\"); });",
      "pm.test(\"Ada meta pagination\", () => pm.expect(pm.response.json().meta).to.include.keys(\"current_page\",\"per_page\",\"total\",\"last_page\"));"
     ]}}]
    },
    {
     "name": "Detail Booking",
     "request": {"method": "GET", "url": "{{base_url}}/bookings/{{booking_id}}"},
     "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
      "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
      "pm.test(\"Format {status, message, data}\", () => { const j = pm.response.json(); pm.expect(j).to.include.keys(\"status\",\"message\",\"data\"); });"
     ]}}]
    },
    {
     "name": "Rincian Layanan Booking",
     "request": {"method": "GET", "url": "{{base_url}}/bookings/{{booking_id}}/details"},
     "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
